{
  "ignoreMsiWithNoMutations": true,
  "logs": {
    "text": ".build/infection/infection-log.txt"
  },
  "minCoveredMsi": 93,
  "minMsi": 60,
  "phpUnit": {
    "configDir": "test\/Unit"
  },
  "source": {
    "directories": [
      "src"
    ],
    "excludes": [
      "Subscriber\/Test\/AfterLastTestMethodFailedSubscriber.php",
      "Subscriber\/Test\/BeforeFirstTestMethodFailedSubscriber.php"
    ]
  },
  "timeout": 10
}
